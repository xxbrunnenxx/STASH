[Unit]
Description=STASH Brain — Sprachnotizen transkribieren und einsortieren
Documentation=https://github.com/xxbrunnenxx/stash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/stash/brain
ExecStart=/home/pi/stash/brain/.venv/bin/stash-brain
Restart=on-failure
RestartSec=5

# Der Dienst braucht den Vault, seine Konfiguration und den Modell-Cache von
# faster-whisper (~/.cache/huggingface) — ohne Letzteren schlägt der allererste
# Modell-Download unter diesem Dienst fehl, weil ProtectHome sonst auch dieses
# Verzeichnis schreibgeschützt macht. Läuft der Dienst schon einmal im
# Vordergrund und lädt das Modell dort herunter, wäre das Verzeichnis zwar
# nur noch lesend nötig — aber genau das lässt sich vorher nicht garantieren.
ProtectSystem=strict
ReadWritePaths=/home/pi/Obsidian /home/pi/.cache/huggingface
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes

# Whisper darf rechnen, aber nicht die Bedienoberfläche lahmlegen.
Nice=5
CPUWeight=60

[Install]
WantedBy=multi-user.target
